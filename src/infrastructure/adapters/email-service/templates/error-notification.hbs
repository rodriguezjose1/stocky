<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Error Notification</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #f44336;
      color: white;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
    }
    .error-details {
      background-color: #f9f9f9;
      border-left: 4px solid #f44336;
      padding: 15px;
      margin-bottom: 20px;
    }
    .stack-trace {
      background-color: #f5f5f5;
      padding: 15px;
      border-radius: 5px;
      white-space: pre-wrap;
      font-family: monospace;
      overflow-x: auto;
    }
    .additional-data {
      background-color: #e8f5e9;
      padding: 15px;
      border-radius: 5px;
      margin-top: 20px;
    }
    .timestamp {
      color: #666;
      font-size: 0.9em;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Error en {{context}}</h1>
  </div>
  
  <div class="error-details">
    <h2>{{error.name}}</h2>
    <p><strong>Mensaje:</strong> {{error.message}}</p>
  </div>
  
  <h3>Stack Trace:</h3>
  <div class="stack-trace">{{error.stack}}</div>
  
  {{#if additionalData}}
  <div class="additional-data">
    <h3>Datos Adicionales:</h3>
    <pre>{{json additionalData}}</pre>
  </div>
  {{/if}}
  
  <div class="timestamp">
    <p>Fecha y hora: {{timestamp}}</p>
  </div>
</body>
</html> 